    %% Standard DFD Notation in Mermaid:
    %% External Entity = Sharp Rectangle [ ... ]
    %% Process = Rounded Rectangle ([ ... ])
    %% Data Store = Parallel-Compartment Rectangle [[ ... ]]
    classDef entity fill:#EFF6FF,stroke:#1E3A8A,stroke-width:2.2px,color:#0F172A,font-weight:bold;
    classDef process fill:#F0FDF4,stroke:#166534,stroke-width:2.2px,color:#0F172A,font-weight:bold;
    classDef datastore fill:#FFFBEB,stroke:#B45309,stroke-width:2.2px,color:#0F172A,font-weight:bold;

    %% Left Column: Verified External Entities
    E_GOOGLE["Google Identity Services<br/>(OAuth 2.0 / OIDC)"]:::entity
    E_SA["Super Admin"]:::entity
    E_ADM["School Admin"]:::entity
    E_PRI["Principal"]:::entity
    E_TUT["Tutor"]:::entity
    E_STU["Student"]:::entity

    %% Center Column: Level 0 Major System Processes (1.0 - 7.0)
    P1(["1.0 Authentication, Consent<br/>& Session Management"]):::process
    P2(["2.0 Account Provisioning, Student<br/>Enrollment & Profile Change Control"]):::process
    P3(["3.0 Tutor Cohort Assignment<br/>& Capacity Management"]):::process
    P4(["4.0 QR Session &<br/>Attendance Processing"]):::process
    P5(["5.0 Assessment Grading, Remediation<br/>Activity & Risk Processing"]):::process
    P6(["6.0 Milestone Evaluation, Summer<br/>Remediation & SY Transition"]):::process
    P7(["7.0 Institutional Analytics, Historical<br/>Archiving & Report Compilation"]):::process

    %% Right Column: Persistent Database Data Stores (D1 - D9)
    D1[["D1 | Users, Whitelist & JWT Blacklist<br/>(users, allowed_emails, token_blacklist_*)"]]:::datastore
    D2[["D2 | Profile Edit Requests<br/>(student_edit_requests)"]]:::datastore
    D3[["D3 | School Years & Enrollments<br/>(school_year, student_enrollment)"]]:::datastore
    D4[["D4 | Tutor Assignment History<br/>(tutor_assignment_history)"]]:::datastore
    D5[["D5 | Attendance Sessions & Logs<br/>(api_attendance_session, api_attendance)"]]:::datastore
    D6[["D6 | Assessment Grades & Activities<br/>(api_grade, api_aral_activity)"]]:::datastore
    D7[["D7 | Academic Risk Alerts<br/>(api_academic_risk)"]]:::datastore
    D8[["D8 | Summer Remediation Records<br/>(summer_record)"]]:::datastore
    D9[["D9 | System & Transition Audit Logs<br/>(audit_logs, transition_audit_log)"]]:::datastore

