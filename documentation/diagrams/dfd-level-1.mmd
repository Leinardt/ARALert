        D9_A[["D9 | audit_logs"]]:::datastore

        E1_STAFF <-->|"In: id_token / Out: JWT & Redirect"| P1_1
        P1_1 <-->|"Out: Verify Token / In: Claims"| E1_GOOGLE
        P1_1 <-->|"R: Email / W: google_sub, last_login"| D1_A
        P1_1 -->|"W: Staff Login Audit"| D9_A

        E1_STU <-->|"In: 12-Digit LRN / Out: JWT & '/student'"| P1_2
        P1_2 <-->|"R: LRN & Active / W: last_login"| D1_A
        P1_2 -->|"W: Student Login Audit"| D9_A

        E1_STAFF <-->|"In: Consent / Out: Profile & PHT Time"| P1_3
