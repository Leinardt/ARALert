# ============================================================
# ARALert Environment Variables Template
# Copy this file to the appropriate location and fill in values
# ============================================================

# --- Backend (.env goes in backend/) ---

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=aralert
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (.env goes in frontend/) ---

VITE_API_URL=/api
